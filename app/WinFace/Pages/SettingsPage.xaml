<UserControl x:Class="WinFace.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,36,30" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Settings &amp; Preferences" Style="{StaticResource H1}" />
      <TextBlock Text="Configure recognition parameters, startup behavior, hardware camera, and privacy." Style="{StaticResource Sub}" Margin="0,0,0,20" />

      <!-- Startup Behaviour -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Startup &amp; Background Behavior" Style="{StaticResource H2}" />
          <TextBlock Text="Configure automatic launch and system tray minimization." Style="{StaticResource Sub}" Margin="0,4,0,12" />
          <CheckBox x:Name="StartupLaunch" Style="{StaticResource Switch}" Margin="0,4,0,8" Click="OnStartupToggle">
            <TextBlock Text="Launch Akhil Face ID automatically on Windows user sign-in" Style="{StaticResource Body}" />
          </CheckBox>
          <CheckBox x:Name="MinimizeToTray" Style="{StaticResource Switch}" Margin="0,4,0,8" IsChecked="True">
            <TextBlock Text="Minimize to System Tray instead of closing the application" Style="{StaticResource Body}" />
          </CheckBox>
          <CheckBox x:Name="DesktopNotifications" Style="{StaticResource Switch}" Margin="0,4,0,4" IsChecked="True">
            <TextBlock Text="Show Windows desktop notifications on authentication events" Style="{StaticResource Body}" />
          </CheckBox>
        </StackPanel>
      </Border>

      <!-- Camera Selection -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Webcam Hardware Selection" Style="{StaticResource H2}" />
          <TextBlock Text="Only physical hardware cameras on USB/internal buses are allowed. Virtual cameras are refused." Style="{StaticResource Sub}" Margin="0,4,0,10" />
          <ListBox x:Name="Cameras" Style="{StaticResource PickList}" />
        </StackPanel>
      </Border>

      <!-- Recognition Parameters -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Biometric Matching &amp; Strictness" Style="{StaticResource H2}" />
          <TextBlock Text="Recognition Strictness Threshold" Style="{StaticResource Body}" Margin="0,14,0,6" />
          <Border Style="{StaticResource SegBar}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="StrictBalanced" Style="{StaticResource Seg}" GroupName="strict" Content="Balanced (Cosine >= 0.42)" />
              <RadioButton x:Name="StrictStrict" Style="{StaticResource Seg}" GroupName="strict" Content="Strict (Cosine >= 0.50)" />
              <RadioButton x:Name="StrictRelaxed" Style="{StaticResource Seg}" GroupName="strict" Content="Relaxed (Cosine >= 0.36)" />
            </StackPanel>
          </Border>
          <TextBlock Text="Balanced provides optimal security and speed on HP Victus built-in webcams. Strict requires closer facial alignment."
                     Style="{StaticResource Sub}" Margin="0,6,0,0" />

          <DockPanel Margin="0,18,0,4">
            <TextBlock x:Name="SearchVal" DockPanel.Dock="Right" Style="{StaticResource Sub}" />
            <TextBlock Text="Search timeout (seconds to detect face)" Style="{StaticResource Body}" />
          </DockPanel>
          <Slider x:Name="Search" Minimum="3" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True" />

          <DockPanel Margin="0,14,0,4">
            <TextBlock x:Name="ChallengeVal" DockPanel.Dock="Right" Style="{StaticResource Sub}" />
            <TextBlock Text="Challenge duration (time allowed for random head turn)" Style="{StaticResource Body}" />
          </DockPanel>
          <Slider x:Name="Challenge" Minimum="2" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" />

          <TextBlock Text="Allowed failed attempts before requiring Windows PIN" Style="{StaticResource Body}" Margin="0,18,0,6" />
          <Border Style="{StaticResource SegBar}">
            <StackPanel x:Name="Fails" Orientation="Horizontal" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Audio Feedback -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Sound &amp; Audio Feedback" Style="{StaticResource H2}" />
          <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Preview Sound" Click="OnPlay" Padding="14,6" FontSize="12.5" />
            <CheckBox x:Name="Sounds" Style="{StaticResource Switch}">
              <TextBlock Text="Play confirmation audio when face authentication succeeds" Style="{StaticResource Body}" />
            </CheckBox>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Data Retention & Storage -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Data Storage &amp; Retention" Style="{StaticResource H2}" />
          <TextBlock Text="Manage local logs and biometric storage." Style="{StaticResource Sub}" Margin="0,4,0,12" />
          <DockPanel Margin="0,4,0,8">
            <Button DockPanel.Dock="Right" Content="Open Data Folder" Click="OnOpenDataFolder" Padding="14,6" FontSize="12.5" />
            <StackPanel>
              <TextBlock Text="Encrypted Vault Path:" Style="{StaticResource Body}" FontWeight="SemiBold" />
              <TextBlock x:Name="DataPathText" Text="C:\ProgramData\WinFace" Style="{StaticResource Sub}" FontFamily="{StaticResource Mono}" FontSize="12" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Save Button -->
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="SaveButton" Content="Save Settings" Style="{StaticResource AccentButton}" Click="OnSave" Padding="20,10" />
        <TextBlock x:Name="SaveText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="14,0,0,0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
