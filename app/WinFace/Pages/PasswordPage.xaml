<UserControl x:Class="WinFace.Pages.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Windows Sign-in Credential" Style="{StaticResource H1}" />
      <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,22"
                 Text="Akhil Face ID logs you into your desktop automatically after your face is recognized. To unlock automatically, Windows requires your Microsoft Account password (your account login password, not your 4-digit PIN). It is encrypted inside your PC's TPM 2.0 security chip and accessible only by the lock screen." />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="StateText" Text="Checking..." Style="{StaticResource Body}" VerticalAlignment="Center" />
          </DockPanel>
          <Button x:Name="VerifyButton" Content="Verify stored credential status" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnVerify" />
          <TextBlock x:Name="VerifyText" Style="{StaticResource Sub}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}">
        <StackPanel>
          <TextBlock x:Name="FormTitle" Text="Save Windows Account Password" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,14"
                     Text="Enter your Microsoft account password (your account login password) or local Windows password. Once saved into your PC's hardware TPM 2.0 security chip, Akhil Face ID unlocks Windows straight into your desktop with a single glance." />
          <TextBlock Text="Account Password (Not 4-digit PIN)" Style="{StaticResource Sub}" Margin="0,0,0,4" />
          <PasswordBox x:Name="Pw1" Width="340" HorizontalAlignment="Left" />
          <TextBlock Text="Confirm Password" Style="{StaticResource Sub}" Margin="0,12,0,4" />
          <PasswordBox x:Name="Pw2" Width="340" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Save Password to TPM 2.0" Style="{StaticResource AccentButton}" Click="OnSave" />
            <TextBlock x:Name="SaveText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="380" />
          </StackPanel>
          <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,14,0,0"
                     Text="Note: Windows restricts 4-digit PINs to manual on-screen typing. For 100% hands-free automatic unlock, Windows requires your Microsoft account password sealed into TPM 2.0." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
