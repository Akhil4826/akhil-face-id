<UserControl x:Class="WinFace.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,36,30" MaxWidth="880" HorizontalAlignment="Left">
      
      <!-- Dashboard Header -->
      <DockPanel Margin="0,0,0,20">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource Surface2}" CornerRadius="20" Padding="14,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="14" Foreground="{StaticResource Accent}" />
              <TextBlock x:Name="ActiveUserText" Text="User: ..." Style="{StaticResource Sub}" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{StaticResource Text}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Akhil Face ID Dashboard" Style="{StaticResource H1}" FontSize="26" />
          <TextBlock Text="Local AI Facial Recognition, Liveness Anti-Spoofing &amp; Hardware Security" Style="{StaticResource Sub}" />
        </StackPanel>
      </DockPanel>

      <!-- Quick Action Buttons -->
      <WrapPanel Margin="0,0,0,18">
        <Button Content="⚡ Start Recognition" Style="{StaticResource AccentButton}" Click="OnStartRecognition" Margin="0,0,10,10" Padding="18,10" />
        <Button Content="👤 Enroll Face" Click="OnEnrollFace" Margin="0,0,10,10" Padding="16,10" />
        <Button Content="👥 Manage Profiles" Click="OnManageProfiles" Margin="0,0,10,10" Padding="16,10" />
        <Button Content="🛡️ Security Centre" Click="OnOpenSecurity" Margin="0,0,10,10" Padding="16,10" />
        <Button Content="⚙️ Settings" Click="OnOpenSettings" Margin="0,0,10,10" Padding="16,10" />
      </WrapPanel>

      <!-- Primary State Card -->
      <Border Style="{StaticResource Card}" Padding="22">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource Surface2}" VerticalAlignment="Top">
            <TextBlock x:Name="HeroIcon" Style="{StaticResource Icon}" FontSize="32" Text="&#xE77B;" HorizontalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock x:Name="HeroTitle" Text="Checking system status..." Style="{StaticResource H2}" FontSize="20" />
            <TextBlock x:Name="HeroSub" Text="" Style="{StaticResource Sub}" Margin="0,4,0,14" />
            <Border Style="{StaticResource SegBar}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeOff" Style="{StaticResource Seg}" GroupName="mode" Content="Off" Click="OnMode" Tag="off" />
                <RadioButton x:Name="ModeTest" Style="{StaticResource Seg}" GroupName="mode" Content="Test Mode Only" Click="OnMode" Tag="test" />
                <RadioButton x:Name="ModeLock" Style="{StaticResource Seg}" GroupName="mode" Content="Lock Screen" Click="OnMode" Tag="lock" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ModeHint" Style="{StaticResource Sub}" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{StaticResource Warn}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Hardware & Architecture Status Matrix -->
      <TextBlock Text="System Diagnostics &amp; Telemetry" Style="{StaticResource H2}" Margin="0,6,0,10" />
      <UniformGrid Columns="3" Margin="0,0,0,16">
        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14">
          <StackPanel>
            <TextBlock Text="HARDWARE CAMERA" Style="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="CardCameraName" Text="HP Wide Vision HD" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock Text="USB 2.0 Built-in Webcam" Style="{StaticResource Sub}" FontSize="11.5" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14">
          <StackPanel>
            <TextBlock Text="RECOGNITION ENGINE" Style="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock Text="ONNX Runtime v1.24.4" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock Text="478 3D Pts + ArcFace 512D" Style="{StaticResource Sub}" FontSize="11.5" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
          <StackPanel>
            <TextBlock Text="SECURITY VAULT" Style="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="CardTpmStatus" Text="TPM 2.0 Ready" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock Text="RSA-2048 Hardware Seal" Style="{StaticResource Sub}" FontSize="11.5" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14">
          <StackPanel>
            <TextBlock Text="ENROLLED PROFILES" Style="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="CardProfilesCount" Text="0 / 3 Enrolled" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock Text="Local Biometric Templates" Style="{StaticResource Sub}" FontSize="11.5" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14">
          <StackPanel>
            <TextBlock Text="LIVENESS SUBSYSTEM" Style="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock Text="3D Parallax DLT Active" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock Text="Dual MiniFASNet Texture Anti-Spoof" Style="{StaticResource Sub}" FontSize="11.5" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,0" Padding="14">
          <StackPanel>
            <TextBlock Text="WINDOWS HELLO COMPAT" Style="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock Text="RGB Enhanced Mode" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock Text="PIN/Password Safe Fallback" Style="{StaticResource Sub}" FontSize="11.5" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Alert Card -->
      <Border x:Name="AlertCard" Style="{StaticResource Card}" BorderBrush="{StaticResource Warn}" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Open Security" Click="OnSecurity" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" FontSize="20" Margin="0,0,14,0" />
          <StackPanel>
            <TextBlock x:Name="AlertTitle" Style="{StaticResource H2}" />
            <TextBlock x:Name="AlertText" Style="{StaticResource Sub}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Setup Checklist -->
      <Border x:Name="SetupCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Guided Setup Checklist" Style="{StaticResource H2}" />
          <TextBlock Text="Complete these steps once to configure face recognition. Your Windows PIN and password will always remain available." Style="{StaticResource Sub}" Margin="0,4,0,12" />
          <StackPanel x:Name="Steps" />
        </StackPanel>
      </Border>

      <!-- Recent Activity Events -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="View Full Logs" Click="OnViewFullLogs" Padding="12,5" FontSize="12.5" />
            <TextBlock Text="Recent Activity &amp; Authentication Events" Style="{StaticResource H2}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="Live real-time local events from the recognition engine and credential provider." Style="{StaticResource Sub}" Margin="0,4,0,12" />
          <StackPanel x:Name="RecentEventsList" />
        </StackPanel>
      </Border>

      <!-- System Health Checks -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Recheck All" Click="OnRecheck" Padding="12,5" FontSize="12.5" />
            <TextBlock Text="Security &amp; Hardware Diagnostics" Style="{StaticResource H2}" VerticalAlignment="Center" />
          </DockPanel>
          <StackPanel x:Name="Checks" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <!-- Privacy & Local Processing Guarantee -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{StaticResource Good}" />
            <TextBlock Text="Privacy &amp; Data Security Guarantee" Style="{StaticResource H2}" Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                     Text="All biometric processing is performed 100% locally on your HP Victus laptop. Akhil Face ID has no cloud connections, no telemetry, and no external tracking. No camera photos are ever stored (camera frames exist only in transient RAM buffers for inference and are immediately freed). Your credentials are hardware-sealed inside the motherboard TPM 2.0 chip." />
          <WrapPanel Margin="0,14,0,0">
            <Button Content="Turn Face Unlock Off" Click="OnOff" Margin="0,0,8,8" />
            <Button Content="Erase All Face Data..." Style="{StaticResource DangerButton}" Click="OnErase" Margin="0,0,8,8" />
            <Button Content="Open Setup Guide" Click="OnGuide" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock x:Name="EraseText" Style="{StaticResource Sub}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
